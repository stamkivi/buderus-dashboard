# KM200 Gateway Configuration
# Get these values from the sticker on your KM200 device

# KM200 Device IP Address (find using network scan)
KM200_HOST=192.168.1.XXX

# Gateway Password (16 characters from device sticker, without dashes)
# Example format: AbCd1234EfGh5678
KM200_GATEWAY_PASSWORD=your-gateway-password-here

# Private/App Password (created in Buderus/Bosch mobile app)
# Leave empty if you haven't created an app password
KM200_PRIVATE_PASSWORD=your-app-password-here

# Server Configuration
PORT=3000
NODE_ENV=development

# Demo Mode (set to true to use mock data without KM200 device)
DEMO_MODE=false
